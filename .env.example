# Set these in your shell; never commit real credentials.
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-verification-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_ACCESS_TOKEN=your-cloud-api-access-token
WHATSAPP_PHONE_NUMBER_ID=your-numeric-test-phone-number-id
# Your WhatsApp number, digits only with country code, e.g. 919876543210
WHATSAPP_ALLOWED_SENDERS=your-whatsapp-number-with-country-code
WHATSAPP_API_VERSION=v27.0
WHATSAPP_PORT=8788
BIZ_OLLAMA_MODEL=qwen2.5-coder:7b
